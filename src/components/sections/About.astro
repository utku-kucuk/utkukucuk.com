---
import { Image } from 'astro:assets';

import portrait from '@/assets/portrait.jpg';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getLocale, useTranslations } from '@/i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const formatNumber = (value: number, decimals = 0) =>
  new Intl.NumberFormat(locale, { minimumFractionDigits: decimals }).format(value);

const stats = [
  { value: 10, prefix: '', suffix: '+', label: t('about.stat.services') },
  { value: 6, prefix: '', suffix: '×', label: t('about.stat.deploy') },
  { value: 40, prefix: '~', suffix: '%', label: t('about.stat.calls') },
  { value: 99.5, prefix: '', suffix: '%', label: t('about.stat.uptime'), decimals: 1 },
];

const facts = [
  { label: t('about.now'), text: t('about.now.text') },
  { label: t('about.learning'), text: t('about.learning.text') },
  { label: t('about.education'), text: t('about.education.text') },
  { label: t('about.languages'), text: t('about.languages.text') },
];
---

<section id="about" class="relative py-28 md:py-40">
  <div class="container-site">
    <SectionHeading index="01" eyebrow={t('about.eyebrow')} title={t('about.title')} />

    <div class="grid gap-14 md:grid-cols-12 md:gap-10">
      <figure
        data-portrait
        class="relative self-start md:sticky md:top-28 md:col-span-5 lg:col-span-4"
      >
        <div class="portrait-frame relative aspect-[4/5] overflow-hidden rounded-3xl border border-line">
          <div class="portrait-zoom size-full transition-transform duration-700 ease-out-expo">
            <Image
              src={portrait}
              alt={t('about.photoAlt')}
              widths={[360, 540, 720]}
              sizes="(min-width: 1024px) 22rem, (min-width: 768px) 40vw, 100vw"
              class="portrait-img size-full object-cover object-top"
              loading="lazy"
            />
          </div>
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 hidden bg-linear-to-t from-bg/40 via-transparent to-transparent dark:block"
          ></div>
        </div>
        <div
          aria-hidden="true"
          class="absolute -inset-4 -z-10 rounded-[2rem] bg-[radial-gradient(closest-side,var(--glow),transparent)] blur-2xl"
        ></div>
      </figure>

      <div class="md:col-span-7 lg:col-span-7 lg:col-start-6">
        <div class="space-y-5 text-lg leading-relaxed text-fg-muted">
          <p data-reveal class="text-xl text-fg">
            {t('about.p1')}
          </p>
          <p data-reveal>{t('about.p2')}</p>
          <p data-reveal>{t('about.p3')}</p>
        </div>

        <dl class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line">
          {stats.map((s) => (
            <div data-reveal class="bg-bg p-5 sm:p-6">
              <dt class="sr-only">{s.label}</dt>
              <dd>
                <span class="block font-mono text-3xl font-medium tracking-tight sm:text-4xl">
                  {s.prefix}
                  <span data-count={s.value} data-decimals={s.decimals ?? 0}>
                    {formatNumber(s.value, s.decimals)}
                  </span>
                  <span class="text-accent">{s.suffix}</span>
                </span>
                <span aria-hidden="true" class="mt-2 block text-sm text-fg-subtle">
                  {s.label}
                </span>
              </dd>
            </div>
          ))}
        </dl>

        <dl class="mt-10 grid gap-x-8 gap-y-5 sm:grid-cols-2">
          {facts.map((f) => (
            <div data-reveal class="border-t border-line pt-4">
              <dt class="eyebrow mb-1.5">{f.label}</dt>
              <dd class="text-sm">{f.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  /* The head sits left of centre with headroom in the source photo: zoom in
     around a point that centres it horizontally and trims the top gap. */
  .portrait-img {
    transform: scale(1.12);
    transform-origin: 3% 98%;
  }

  .portrait-zoom {
    transform-origin: 50% 40%;
  }

  .portrait-frame:hover .portrait-zoom {
    transform: scale(1.06);
  }
</style>
