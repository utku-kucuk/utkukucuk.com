---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { earlier, experience } from '@/data/experience';
import { getLocale, useTranslations } from '@/i18n/utils';

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
---

<section id="experience" class="relative py-28 md:py-40">
  <div class="container-site">
    <SectionHeading index="02" eyebrow={t('experience.eyebrow')} title={t('experience.title')} />

    <ol data-timeline class="relative ml-2 md:ml-0">
      <!-- rail + progress fill -->
      <span
        aria-hidden="true"
        class="absolute top-2 bottom-2 left-0 w-px bg-line md:left-[11.5rem]"
      ></span>
      <span
        aria-hidden="true"
        data-timeline-fill
        class="absolute top-2 bottom-2 left-0 w-px origin-top bg-linear-to-b from-accent to-accent-2 md:left-[11.5rem]"
      ></span>

      {experience.map((role) => (
        <li
          data-reveal
          class="relative grid gap-3 pb-14 pl-8 last:pb-0 md:grid-cols-[11.5rem_1fr] md:gap-0 md:pl-0"
        >
          <span
            aria-hidden="true"
            class:list={[
              'absolute top-2 left-0 size-2.5 -translate-x-1/2 rounded-full border-2 border-bg md:left-[11.5rem]',
              role.current
                ? 'bg-accent-2 shadow-[0_0_0_4px_color-mix(in_srgb,var(--accent-2)_25%,transparent)]'
                : 'bg-fg-subtle',
            ]}
          />
          <p class="font-mono text-xs leading-6 tracking-wide text-fg-subtle md:pr-8 md:text-right">
            {role.period[locale]}
          </p>
          <div class="md:pl-10">
            <h3 class="text-xl font-semibold tracking-tight">
              {role.title[locale]}
              <span class="text-fg-subtle"> · </span>
              {role.url ? (
                <a
                  href={role.url}
                  target="_blank"
                  rel="noopener"
                  class="text-accent hover:underline"
                >
                  {role.company}
                </a>
              ) : (
                <span class="text-accent">{role.company}</span>
              )}
            </h3>
            <p class="mt-1 flex items-center gap-2 text-sm text-fg-subtle">
              {role.type[locale]}
              {role.current && (
                <span class="rounded-full border border-accent-2/40 px-2 py-0.5 font-mono text-[0.65rem] tracking-wider text-accent-2 uppercase">
                  {t('experience.current')}
                </span>
              )}
            </p>
            <ul class="mt-4 space-y-2.5 text-fg-muted">
              {role.highlights[locale].map((h) => (
                <li class="relative pl-5 leading-relaxed before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2.5 before:bg-fg-subtle">
                  {h}
                </li>
              ))}
            </ul>
            <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tech">
              {role.tech.map((tech) => (
                <li class="rounded-full border border-line px-3 py-1 font-mono text-xs text-fg-muted">
                  {tech}
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>

    <p
      data-reveal
      class="mt-14 max-w-2xl border-t border-line pt-6 text-sm text-fg-subtle md:ml-[11.5rem] md:pl-10"
    >
      {earlier[locale]}
    </p>
  </div>
</section>
