---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
}

const { index, eyebrow, title, subtitle } = Astro.props;
---

<header class="mb-14 md:mb-20">
  <p data-reveal class="eyebrow mb-5 flex items-center gap-3">
    <span class="text-accent">{index}</span>
    <span class="h-px w-10 bg-line"></span>
    {eyebrow}
  </p>
  <h2
    data-reveal-lines
    class="max-w-3xl text-[clamp(2.2rem,5.5vw,4.25rem)] leading-[1.02] font-semibold tracking-[-0.035em] text-balance"
  >
    {title}
  </h2>
  {subtitle && (
    <p data-reveal class="mt-5 max-w-xl text-lg text-fg-muted">
      {subtitle}
    </p>
  )}
</header>
