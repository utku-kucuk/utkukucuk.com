---
import ArchDiagram from '@/components/projects/ArchDiagram.astro';
import type { Locale } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import type { Project } from '@/lib/projects';

interface Props {
  project: Project;
  index: number;
  total: number;
  locale: Locale;
}

const { project, index, total, locale } = Astro.props;
const t = useTranslations(locale);
const { data } = project;
const href = localizePath(`/projects/${project.slug}/`, locale);
const pad = (n: number) => String(n).padStart(2, '0');
---

<article
  data-tilt
  class="project-card group relative flex h-full flex-col overflow-hidden rounded-3xl border border-line bg-bg-elevated/70 p-6 backdrop-blur-sm transition-colors duration-500 hover:border-fg-subtle/40 sm:p-8"
>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-1/2 -right-1/4 size-[28rem] rounded-full bg-[radial-gradient(closest-side,var(--glow),transparent)] opacity-0 transition-opacity duration-700 group-hover:opacity-100"
  ></div>

  <header class="flex items-start justify-between gap-6">
    <div>
      <p class="font-mono text-xs text-fg-subtle">
        <span class="text-accent">{pad(index + 1)}</span> / {pad(total)}
      </p>
      <h3 class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-2xl font-semibold tracking-tight sm:text-3xl">
        <!-- The ::after overlay makes the whole card open the case study -->
        <a
          href={href}
          class="decoration-accent/50 decoration-2 underline-offset-[6px] transition-colors duration-300 after:absolute after:inset-0 after:z-10 group-hover:text-accent group-hover:underline focus-visible:text-accent focus-visible:underline focus-visible:outline-none"
        >
          {data.title}
          <span
            aria-hidden="true"
            class="ml-1 inline-block text-[0.8em] text-fg-subtle transition-[translate,color] duration-300 group-hover:translate-x-1 group-hover:text-accent"
          >
            →
          </span>
        </a>
        {data.status === 'in-progress' && (
          <span class="rounded-full border border-accent/40 px-2.5 py-0.5 font-mono text-[0.65rem] font-normal tracking-wider text-accent uppercase">
            {t('work.inProgress')}
          </span>
        )}
      </h3>
      <p class="mt-1.5 text-fg-muted">{data.tagline}</p>
    </div>
    <div class="flex shrink-0 items-center">
      {data.live && (
        <a
          href={data.live}
          target="_blank"
          rel="noopener"
          aria-label={`${data.title}: ${t('work.live')}`}
          title={t('work.live')}
          class="relative z-20 inline-flex h-10 items-center gap-2 rounded-full border border-line px-4 font-mono text-xs transition-colors hover:border-status hover:text-status"
        >
          <span class="relative flex size-2" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-status opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-status"></span>
          </span>
          {t('work.liveLabel')}
        </a>
      )}
    </div>
  </header>

  <div class="relative my-6 rounded-2xl border border-line bg-bg/60 p-3 sm:p-4">
    <ArchDiagram name={data.diagram} title={`${data.title} — ${t('project.architecture')}`} />
  </div>

  <ul class="relative space-y-1.5 text-sm text-fg-muted">
    {data.highlights.slice(0, 2).map((h) => (
      <li class="flex gap-2.5">
        <span class="mt-[0.55em] size-1 shrink-0 rounded-full bg-accent-2" aria-hidden="true" />
        {h}
      </li>
    ))}
  </ul>

  <footer class="relative mt-auto flex flex-wrap items-end justify-between gap-4 pt-6">
    <ul class="flex flex-wrap gap-1.5">
      {data.stack.slice(0, 5).map((s) => (
        <li class="rounded-full border border-line px-2.5 py-1 font-mono text-[0.7rem] text-fg-muted">
          {s}
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-4 font-mono text-xs">
      <a
        href={href}
        tabindex="-1"
        class="relative z-20 text-accent underline-offset-4 hover:underline"
      >
        {t('work.caseStudy')} →
      </a>
      {data.repo ? (
        <a
          href={data.repo}
          target="_blank"
          rel="noopener"
          class="relative z-20 text-fg-subtle underline-offset-4 transition-colors hover:text-fg hover:underline"
        >
          {t('work.source')} ↗
        </a>
      ) : (
        <span class="text-fg-subtle">{t('work.private')}</span>
      )}
    </div>
  </footer>
</article>
