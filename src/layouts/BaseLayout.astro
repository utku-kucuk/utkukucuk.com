---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import 'lenis/dist/lenis.css';
import '@/styles/global.css';

import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import Cursor from '@/components/ui/Cursor.astro';
import { site } from '@/data/site';
import { languages, type Locale } from '@/i18n/ui';
import { getLocale, switchLocalePath, useTranslations } from '@/i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** 'website' for the home page, 'article' for case studies */
  type?: 'website' | 'article';
}

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const {
  title = t('meta.title'),
  description = t('meta.description'),
  type = 'website',
} = Astro.props;
const ogImage = new URL(`/og/og-${locale}.jpg`, Astro.site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.shortName,
  url: site.url,
  image: new URL('/og/og-en.jpg', Astro.site).href,
  jobTitle: 'Backend Software Engineer',
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Istanbul', addressCountry: 'TR' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Istanbul Aydın University' },
  knowsAbout: [
    'Java',
    'Spring Boot',
    'REST APIs',
    'Microservices',
    'PostgreSQL',
    'Docker',
    'Linux',
    'CI/CD',
  ],
  sameAs: [site.socials.github, site.socials.linkedin],
};

const canonical = new URL(Astro.url.pathname, Astro.site);
const alternates = (Object.keys(languages) as Locale[]).map((l) => ({
  locale: l,
  href: new URL(switchLocalePath(Astro.url, l), Astro.site).href,
}));
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.locale} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#07080b" />
    <meta name="author" content={site.name} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={locale === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'tr' ? 'en_US' : 'tr_TR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      (() => {
        let theme = 'dark';
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') theme = stored;
          else if (matchMedia('(prefers-color-scheme: light)').matches) theme = 'light';
        } catch {
          /* storage unavailable */
        }
        document.documentElement.dataset.theme = theme;
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('js-anim');
          // fail-safe: never keep content hidden if scripts fail to load
          setTimeout(() => document.documentElement.classList.remove('js-anim'), 3000);
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-accent px-4 py-2 text-accent-contrast focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      {t('nav.skip')}
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Cursor />
    <script>
      import '@/scripts/site';
    </script>
  </body>
</html>
